# Copy this file to .env and replace the example values locally.
# Never commit the real .env file.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://your-host:5432/your-database?sslmode=require
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password
# Connections per backend instance. The Supabase session pooler allows 15 for the whole project
# (Render + every local backend), so keep these small.
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log the SQL executed by Hibernate (set to false in production)
JPA_SHOW_SQL=true

# JWT (Base64 secret, at least 256 bits). Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Initial admin user, created on first startup when there are no users.
# If ADMIN_PASSWORD is empty, no admin is created.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Load the sample catalog and initial inventory only when explicitly enabled.
DEMO_CATALOG_ENABLED=false

# AI providers - not used yet
OPENAI_API_KEY=
OPENROUTER_API_KEY=
