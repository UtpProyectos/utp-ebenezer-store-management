# Copy this file to .env and replace the example values locally.
# Never commit the real .env file.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://your-host:5432/your-database?sslmode=require
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (Base64 secret, at least 256 bits) - not used yet
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# AI providers - not used yet
OPENAI_API_KEY=
OPENROUTER_API_KEY=
