        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#999999;arcSize=3;fontSize=12;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria (subrayada)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; clave for&amp;#225;nea (cursiva)&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; restricci&amp;#243;n UNIQUE&lt;br&gt;Pata de gallo (lado FK) = 0..N&lt;br&gt;Barra doble (lado PK) = 1 obligatorio (FK NOT NULL)&lt;br&gt;C&amp;#237;rculo + barra (lado PK) = 0..1 (FK opcional)&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#205;ndices&lt;/b&gt;&lt;br&gt;product (name)&lt;br&gt;lot (product_id, expiration_date)&lt;br&gt;inventory_movement (product_id, movement_date)&lt;br&gt;inventory_movement (lot_id, movement_date)&lt;br&gt;inventory_movement (movement_type)&lt;br&gt;&lt;br&gt;&lt;b&gt;M&amp;#243;dulos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9673A6&quot;&gt;&amp;#9632;&lt;/font&gt; Seguridad&lt;br&gt;&lt;font color=&quot;#6C8EBF&quot;&gt;&amp;#9632;&lt;/font&gt; Catálogo&lt;br&gt;&lt;font color=&quot;#82B366&quot;&gt;&amp;#9632;&lt;/font&gt; Compras / proveedores&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;&amp;#9632;&lt;/font&gt; Ventas&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&amp;#9632;&lt;/font&gt; Inventario / consumo&lt;br&gt;&lt;font color=&quot;#D6B656&quot;&gt;&amp;#9632;&lt;/font&gt; Lista de compras&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;&amp;#9632;&lt;/font&gt; Configuración" vertex="1">
